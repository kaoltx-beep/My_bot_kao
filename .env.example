# Jarvis AI Assistant — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in the real values.
# Never commit .env to git.

# ── Telegram ──────────────────────────────────────────────────────────────
# Bot token from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Your personal Telegram chat ID (use @userinfobot to find it).
# IMPORTANT: Only messages from this chat ID will be processed.
# Messages from anyone else are silently dropped for security.
TELEGRAM_CHAT_ID=your_numeric_chat_id_here

# ── AI ────────────────────────────────────────────────────────────────────
# Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use (optional — defaults to llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# ── Device Control (optional) ─────────────────────────────────────────────
# MacroDroid webhook URL for Android device actions (battery, YouTube, etc.)
# Leave blank if you are not using MacroDroid.
MACRODROID_WEBHOOK_URL=

# ── Google Sheets / Drive (optional) ──────────────────────────────────────
# Path to your Google service account JSON file.
# Required only for work logging, expense backup, and memory sync to Sheets.
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# ── Dashboard (optional) ──────────────────────────────────────────────────
# Secret token for the /status and /pulse API endpoints.
# If set, requests must include header:  X-Dashboard-Token: <value>
# Leave blank to disable authentication (not recommended in production).
DASHBOARD_TOKEN=
