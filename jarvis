from fastapi import FastAPI
from pydantic import BaseModel
import uvicorn
import time

app = FastAPI()

# 1. กำหนดรูปแบบโครงสร้างข้อมูล (Schema) ตามที่เราออกแบบไว้
class CommandFeedback(BaseModel):
    command_id: str
    status: str
    device: str
    action: str
    message: str
    time: int

# 2. สร้างพอร์ต (Route) สำหรับรับ HTTP POST จาก MacroDroid
@app.post("/webhook/feedback")
async def receive_feedback(feedback: CommandFeedback):
    print(f"\n📩 [ได้รับ Feedback ใหม่] แปลงข้อมูลแล้ว:")
    print(f"🔑 Command ID: {feedback.command_id}")
    print(f"📊 สถานะ: {'✅' if feedback.status == 'success' else '❌'} {feedback.status.upper()}")
    print(f"📱 อุปกรณ์: {feedback.device}")
    print(f"⚙️ แอคชัน: {feedback.action}")
    print(f"💬 ข้อความ: {feedback.message}")
    
    # (สเต็ปถัดไป: นำข้อมูลนี้ไปอัปเดตลง logs.db หรือสั่งให้บอทแจ้งเตือนเข้า Telegram)
    
    return {"message": "Feedback received successfully", "id": feedback.command_id}

# 3. คำสั่งสั่งให้ Server เริ่มทำงานบนมือถือ
if __name__ == "__main__":
    # รันระบบที่ IP 127.0.0.1 (Localhost) พอร์ต 8000
    print("🚀 Jarvis Feedback Server กำลังสตาร์ท...")
    uvicorn.run(app, host="127.0.0.1", port=8000)
